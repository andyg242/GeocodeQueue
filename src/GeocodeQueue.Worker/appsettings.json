{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "Data Source=geocode-queue.db",
    "SeedOnStartup": true,
    "SeedFile": "Seed/addresses.txt"
  },
  "Lease": {
    "Duration": "00:00:30",
    "RenewalJitter": "00:00:00.250"
  },
  "Processing": {
    "Concurrency": 4,
    "MaxAttempts": 5,
    "IdlePollInterval": "00:00:05",
    "RetryBaseDelay": "00:00:10",
    "ExitWhenQueueEmpty": false
  },
  "Geocoding": {
    "Provider": "Google",
    "ApiKey": "",
    "BaseUrl": "https://maps.googleapis.com/maps/api/geocode/json"
  }
}
